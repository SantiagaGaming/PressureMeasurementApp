{
  "ReverseProxy": {
    "Routes": {
      "auth-service": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/auth" }
        ]
      },
      "measurement-service": {
        "ClusterId": "measurement-cluster",
        "Match": {
          "Path": "/measurements/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/measurements" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "server1": {
            "Address": "http://localhost:5206/"
          }
        }
      },
      "measurement-cluster": {
        "Destinations": {
          "server1": {
            "Address": "http://localhost:5000/"
          }
        }
      }
    }
  },
  "Jwt": {
    "Key": "your-super-secret-key-with-at-least-32-characters",
    "Issuer": "PressureMeasurementApp",
    "Audience": "PressureMeasurementApp"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
