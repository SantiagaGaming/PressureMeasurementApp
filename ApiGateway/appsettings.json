{
  "ReverseProxy": {
    "Routes": {
      "auth-service": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/auth/{**catch-all}" }
      
      },
      "measurement-service": {
        "ClusterId": "measurement-cluster",
        "Match": { "Path": "/measurements/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "server1": { "Address": "http://localhost:5206/api" }
        }
      },
      "measurement-cluster": {
        "Destinations": {
          "server1": { "Address": "http://localhost:5000/api/PressureMeasurement" }
        }
      }
    }
  }
,
  "Jwt": {
    "Key": "your-super-secret-key-with-at-least-32-characters561561561651321516123116asdqwedasdadqwdafgzxdfasdASDASFWGDFGSDFASDASDQA1651S6D51",
    "Issuer": "PressureMeasurementApp",
    "Audience": "PressureMeasurementApp"
  }
}